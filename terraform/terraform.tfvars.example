###############################################################################
# Exemplo de tfvars - copie para terraform.tfvars e ajuste se necessario.
#   cp terraform.tfvars.example terraform.tfvars
###############################################################################

# Regiao / projeto
aws_region   = "us-east-1"
project_name = "togglemaster"
cluster_name = "togglemaster-eks"

# Networking
vpc_cidr            = "10.0.0.0/16"
availability_zones  = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# EKS
# kubernetes_version = "1.33"          # null usa a versao default do servico
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 4

# AWS Academy: descomente e informe os ARNs da LabRole para reutilizar IAM
# existente (o modulo nao criara nenhuma role/policy):
# existing_cluster_role_arn = "arn:aws:iam::<ACCOUNT>:role/LabRole"
# existing_node_role_arn    = "arn:aws:iam::<ACCOUNT>:role/LabRole"

# Bancos de dados
db_instance_class = "db.t4g.micro"
redis_node_type   = "cache.t4g.micro"

# Mensageria
sqs_queue_name = "tooglemaster-evaluation-events-queue"

# CI
github_repository = "maiconjfa/techchallenge2-projetofiap"

# ArgoCD - instalado em camada separada APOS o primeiro apply:
#   1) terraform apply                          (esta camada: toda a infra)
#   2) aws eks update-kubeconfig --name togglemaster-eks --region us-east-1
#   3) cd argocd-install && terraform init && terraform apply
